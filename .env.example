# Copy to `.env` and fill in. `.env` is gitignored: never commit real keys.
# In GitHub Actions these come from repository secrets instead.

# Alpha Vantage (https://www.alphavantage.co/support/#api-key). Optional:
# without it the scan still runs, just without news sentiment.
ALPHAVANTAGE_API_KEY=

# Telegram bot (see README "Telegram setup"). Optional: without both values
# the scan still runs, just without the alert.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides (defaults shown)
# STOCKSCAN_CONFIG_FILE=config/config.toml
# STOCKSCAN_OUTPUT_DIR=out
# STOCKSCAN_DB_PATH=data/stockscan.duckdb
# STOCKSCAN_CACHE_DIR=.cache
